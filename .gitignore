# priv/ holds only the per-platform prebuilt NIFs (rast-<os>-<arch>), which the
# CI build-nif workflow produces and commits so the hex package works without a
# Rust toolchain. Ignore everything else that lands there.
priv/*
!priv/rast-*.so
!priv/rast-*.dll
!priv/rast-*.dylib

# ---> Erlang
.rebar3
_build
_checkouts
_vendor
.eunit
*.o
*.beam
*.plt
*.swp
*.swo
.erlang.cookie
ebin
log
erl_crash.dump
logs
.idea
*.iml
rebar3.crashdump
*~

# rebar 3
_build/
_checkouts/

# ---> Rust
native/rast/target/

# ---> docs (generated)
/doc/*.html
/doc/*.css
/doc/*.png
/doc/edoc-info
