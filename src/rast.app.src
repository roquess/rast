{application, rast, [
    {description, "SIMD raster tile processing for Erlang: fused typed kernels + bounded-memory OTP tiling"},
    {vsn, "0.1.1"},
    {registered, [rast_sup]},
    {mod, {rast_app, []}},
    {applications, [kernel, stdlib]},
    {env, []},
    {modules, []},

    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/roquess/rast"}]},

    {files, [
        "src",
        "native/rast/src/lib.rs",
        "native/rast/Cargo.toml",
        "native/rast/Cargo.lock",
        "priv/rast-linux-x86_64.so",
        "priv/rast-darwin-x86_64.so",
        "priv/rast-darwin-aarch64.so",
        "priv/rast-windows-x86_64.dll",
        "rebar.config", "Makefile", "README*", "CHANGELOG*", "LICENSE*", "NOTICE*"
    ]},

    %% .so is hard-excluded by rebar3_hex (treated as a build artifact); force
    %% the prebuilt Linux/macOS NIFs back in so the package works without cargo.
    {include_paths, ["priv/rast-*.so"]}
]}.
