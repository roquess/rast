{application, rast, [
    {description, "SIMD raster tile processing for Erlang: fused typed kernels + bounded-memory OTP tiling"},
    {vsn, "0.1.0"},
    {registered, [rast_sup]},
    {mod, {rast_app, []}},
    {applications, [kernel, stdlib]},
    {env, []},
    {modules, []},

    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/roquess/rast"}]},
    {maintainers, ["Steve Roques <steve.roques@gmail.com>"]},

    {files, [
        "src",
        "native/rast/src/lib.rs",
        "native/rast/Cargo.toml",
        "native/rast/Cargo.lock",
        "priv/rast.dll",
        "priv/rast.so",
        "priv/rast.dylib",
        "rebar.config", "Makefile", "README*", "CHANGELOG*", "LICENSE*", "NOTICE*"
    ]}
]}.
